<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.popovyuriy.tabsgroupplugin</id>
    <name>Tab Groups</name>
    <vendor email="popov.yuriy.92@gmail.com" url="https://github.com/PopovYuriy">Popov Yurii</vendor>

    <!--
      Platform-only dependency: no language, VCS or IDE-specific module is required, so the plugin
      installs in every JetBrains IDE. Branch detection reads .git/HEAD directly rather than
      depending on the Git4Idea plugin, which the user could have disabled.

      <version> and <idea-version> are intentionally absent: the IntelliJ Platform Gradle Plugin
      injects them from gradle.properties, and hardcoding them here silently overrode the build.
    -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          Services are declared via @Service(Service.Level.PROJECT) on the classes themselves.
          The previous <projectService> entries registered each one a second time.
        -->
        <toolWindow
                factoryClass="com.github.popovyuriy.tabsgroupplugin.toolWindow.TabGroupsToolWindowFactory"
                id="Tab Groups"
                anchor="right"
                secondary="false"
                canCloseContents="false"
                icon="AllIcons.Actions.ListFiles"
                doNotActivateOnStart="true"/>

        <postStartupActivity
                implementation="com.github.popovyuriy.tabsgroupplugin.startup.TabGroupsStartupActivity"/>

        <editorTabColorProvider
                implementation="com.github.popovyuriy.tabsgroupplugin.ui.GroupTabColorProvider"/>
    </extensions>

    <actions>
        <action
                id="TabGroups.AddToGroup"
                class="com.github.popovyuriy.tabsgroupplugin.actions.AddToGroupAction"
                text="Add to Group..."
                description="Add this file to a tab group">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>